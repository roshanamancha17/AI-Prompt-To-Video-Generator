# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/content_studio"

# ── Auth.js ─────────────────────────────────────────────────────────────
# Generate with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# ── AI providers (server-side only — never exposed to the browser) ──────
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Which image provider to use. Leave unset (or "gemini") for Gemini's
# native image model — higher quality, needs GEMINI_API_KEY + billing
# enabled on that Google Cloud project. Set to "pollinations" for a free,
# no-API-key alternative (lower quality/consistency, no uptime guarantee —
# see lib/providers/image/PollinationsImageProvider.ts for the tradeoffs).
# Set to "stable-diffusion" to use Stable Diffusion 3.5 via Stability AI's
# hosted API (needs STABILITY_API_KEY below). Set to "local-cpu" for free,
# offline, CPU-only generation via a locally-running FastSD CPU server
# (needs FastSD CPU installed and running separately — see
# lib/providers/image/LocalCPUImageProvider.ts).
# Restart the server after changing this.
IMAGE_PROVIDER=gemini

# Optional: a second image provider to automatically fall back to if the
# primary one above fails (any reason except a missing API key for the
# primary, which is treated as a config mistake and surfaced directly).
# Same allowed values as IMAGE_PROVIDER. Leave blank to disable fallback.
# e.g. IMAGE_PROVIDER=gemini + IMAGE_PROVIDER_FALLBACK=stable-diffusion
# means: try Gemini, and if it errors out, retry the same prompt on
# Stable Diffusion before giving up.
IMAGE_PROVIDER_FALLBACK=

# Needed only if IMAGE_PROVIDER or IMAGE_PROVIDER_FALLBACK is
# "stable-diffusion". Get a key at platform.stability.ai.
STABILITY_API_KEY=
# Optional — defaults to sd3.5-large. Other options: sd3.5-large-turbo
# (faster, slight quality tradeoff), sd3.5-medium (cheapest).
STABILITY_SD_MODEL=

# Needed only if IMAGE_PROVIDER or IMAGE_PROVIDER_FALLBACK is
# "local-cpu". Requires FastSD CPU (github.com/rupeshs/fastsdcpu) running
# separately on this or another machine, started with:
#   python src/app.py --api
# Free, no API key, fully offline — but only works while that process is
# running, and quality depends on which model FastSD CPU is configured
# to use (LCM-LoRA + Dreamshaper v8 recommended for a real quality/speed
# balance on CPU; see FastSD CPU's own README for other options).
LOCAL_SD_API_URL=http://localhost:8000
LOCAL_SD_STEPS=3
LOCAL_SD_MODEL=

# Needed only if you use the "RTX" toggle in the Images tab (local GPU
# generation via rtx_server.py, a separate persistent Python process —
# see /rtx-server in the project's sibling folder, not part of this
# Next.js app). Defaults to the standard local port if unset.
RTX_SERVER_URL=http://127.0.0.1:8001

# Needed only if IMAGE_PROVIDER or IMAGE_PROVIDER_FALLBACK is "unsplash".
# This is NOT generative — it searches Unsplash's real stock photo
# library for the closest match to each scene's keywords, rather than
# rendering the scene as described. Good for generic B-roll/mood shots,
# weak for anything needing a specific character or exact composition.
# Get a free key (Demo tier, capped 50 req/hour) at unsplash.com/developers.
UNSPLASH_ACCESS_KEY=

# ── Object storage (Cloudflare R2 by default; any S3-compatible works) ──
STORAGE_PROVIDER="r2"
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# ── Social publishing OAuth (Phase 7 — not required for Phase 1–5) ───────
# ── Social publishing OAuth ───────────────────────────────────────────────
# YouTube is used now for Channel Insights (read-only connection: syncing
# your videos + stats to learn from past performance). Register an OAuth
# client in Google Cloud Console with redirect URI:
#   {your app URL}/api/platforms/youtube/callback
# and scopes: youtube.readonly, yt-analytics.readonly
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram/Facebook/X are not yet wired up (Phase 7 — publishing).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=
