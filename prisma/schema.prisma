generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH / USER
// ─────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  brands    Brand[]
  projects  Project[]
  apiUsage  ApiUsage[]
  platforms PlatformConnection[]
  channelVideos   ChannelVideoMetric[]
  channelInsights ChannelInsight[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// BRAND / VOICE / PILLARS
// ─────────────────────────────────────────────────────────────────────────

model Brand {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String?  @db.Text
  audience      String?  @db.Text
  positioning   String?  @db.Text
  tone          String?
  ctaStyle      String?
  wordsToUse    String[] @default([])
  wordsToAvoid  String[] @default([])
  languageRules Json? // flexible: e.g. Hinglish script-mixing rules
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillars  ContentPillar[]
  projects Project[]
}

model ContentPillar {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  createdAt DateTime @default(now())

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([brandId, name])
}

// ─────────────────────────────────────────────────────────────────────────
// PROJECT (the central entity)
// ─────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  IDEA
  GENERATING
  DRAFT
  REVIEW
  APPROVED
  READY
  SCHEDULED
  PUBLISHED
  FAILED
}

enum ContentType {
  INSTAGRAM_REEL
  YOUTUBE_SHORT
  X_TWITTER
  FACEBOOK
  MULTI_PLATFORM
}

enum Language {
  ENGLISH
  HINDI
  HINGLISH
  CUSTOM
}

enum CtaLevel {
  LEVEL_1_NONE
  LEVEL_2_SOFT_CURIOSITY
  LEVEL_3_PROFILE
  LEVEL_4_WEBSITE
  LEVEL_5_DIRECT
}

model Project {
  id       String @id @default(cuid())
  userId   String
  brandId  String?
  pillarId String?

  topic             String        @db.Text
  contentType       ContentType
  language          Language
  customLanguage    String?
  audience          String?       @db.Text
  tone              String[]      @default([])
  targetDurationSec Int           @default(30)
  imagePromptCount  Int           @default(7)
  thumbnailCount    Int           @default(2)
  xPostCount        Int           @default(5)
  ctaLevel          CtaLevel      @default(LEVEL_2_SOFT_CURIOSITY)
  ctaText           String?
  websiteUrl        String?
  additionalNotes   String?       @db.Text
  status            ProjectStatus @default(IDEA)

  // Flexible reused-trait bag injected into every relevant image prompt.
  // Structured per-prompt fields still live as real columns on ImagePrompt.
  characterBible Json?

  maintainCharacterContinuity Boolean @default(true)

  strategyApproved Boolean @default(false)
  scriptApproved   Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  scheduledDate DateTime?
  publishedDate DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand  Brand?         @relation(fields: [brandId], references: [id])
  pillar ContentPillar? @relation(fields: [pillarId], references: [id])

  strategy    ContentStrategy?
  scripts     Script[]
  scenes      Scene[]
  thumbnails  Thumbnail[]
  voiceovers  Voiceover[]
  socialPosts SocialPost[]
  assets      Asset[]
  jobs        GenerationJob[]
  schedule    Schedule?
  videoRenderSettings VideoRenderSettings?
  videoRenders        VideoRender[]

  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// STAGE 1 — CONTENT STRATEGY
// ─────────────────────────────────────────────────────────────────────────

model ContentStrategy {
  id            String @id @default(cuid())
  projectId     String @unique
  coreProblem   String @db.Text
  emotion       String
  hook          String @db.Text
  message       String @db.Text
  ctaStrategy   String @db.Text
  contentAngle  String @db.Text

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// SCRIPT (versioned — never overwritten)
// ─────────────────────────────────────────────────────────────────────────

model Script {
  id                String   @id @default(cuid())
  projectId         String
  version           Int
  isActive          Boolean  @default(true)
  content           String   @db.Text
  voiceoverVersion  String   @db.Text
  onScreenText      String?  @db.Text
  estimatedDuration Int? // seconds
  createdAt         DateTime @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceovers Voiceover[]

  @@unique([projectId, version])
}

// ─────────────────────────────────────────────────────────────────────────
// SCENES
// ─────────────────────────────────────────────────────────────────────────

model Scene {
  id           String  @id @default(cuid())
  projectId    String
  sceneNumber  Int
  durationLabel String // e.g. "0-2 sec"
  voiceover    String  @db.Text
  onscreenText String? @db.Text
  visualGoal   String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imagePrompts ImagePrompt[]

  @@unique([projectId, sceneNumber])
}

// ─────────────────────────────────────────────────────────────────────────
// IMAGE PROMPTS (versioned) + GENERATED IMAGES (every generation kept)
// ─────────────────────────────────────────────────────────────────────────

enum ImagePromptContext {
  SCENE
  THUMBNAIL
  X_POST
}

model ImagePrompt {
  id      String              @id @default(cuid())
  sceneId String?
  context ImagePromptContext  @default(SCENE)
  version Int                 @default(1)
  isActive Boolean            @default(true)

  subject             String  @db.Text
  environment         String  @db.Text
  action              String? @db.Text
  emotion             String
  lighting            String
  camera              String
  style               String
  composition         String
  negativeRequirements String? @db.Text
  aspectRatio         String  @default("9:16")

  createdAt DateTime @default(now())

  scene           Scene?           @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  generatedImages GeneratedImage[]
  thumbnail       Thumbnail?
  socialPost      SocialPost?      @relation("PostImagePrompt")
}

model GeneratedImage {
  id            String   @id @default(cuid())
  imagePromptId String
  isActive      Boolean  @default(true)
  provider      String
  model         String
  assetId       String
  createdAt     DateTime @default(now())

  imagePrompt ImagePrompt @relation(fields: [imagePromptId], references: [id], onDelete: Cascade)
  asset       Asset       @relation(fields: [assetId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────
// THUMBNAILS
// ─────────────────────────────────────────────────────────────────────────

model Thumbnail {
  id                String  @id @default(cuid())
  projectId         String
  text              String
  visualConcept     String  @db.Text
  emotionalTrigger  String
  imagePromptId     String  @unique

  createdAt DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imagePrompt ImagePrompt @relation(fields: [imagePromptId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────
// VOICEOVER (versioned)
// ─────────────────────────────────────────────────────────────────────────

model Voiceover {
  id             String   @id @default(cuid())
  projectId      String
  scriptId       String
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  provider       String   @default("elevenlabs")
  voiceId        String
  scriptSnapshot String   @db.Text
  stability      Float?
  similarity     Float?
  style          Float?
  speed          Float?
  assetId        String?
  wordTimings    Json? // [{ word, startSec, endSec }] from ElevenLabs alignment — powers synced subtitles
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  script  Script  @relation(fields: [scriptId], references: [id])
  asset   Asset?  @relation(fields: [assetId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────
// SOCIAL POSTS (per-platform, versioned)
// ─────────────────────────────────────────────────────────────────────────

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  X_TWITTER
}

enum SocialPostType {
  TITLE
  DESCRIPTION
  HASHTAGS
  KEYWORDS
  CAPTION
  FIRST_COMMENT
  STORY_CTA
  POST
}

model SocialPost {
  id            String         @id @default(cuid())
  projectId     String
  platform      SocialPlatform
  postType      SocialPostType
  content       String         @db.Text
  orderIndex    Int            @default(0) // for X's 5 standalone posts
  version       Int            @default(1)
  isActive      Boolean        @default(true)
  imagePromptId String?        @unique

  createdAt DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imagePrompt ImagePrompt? @relation("PostImagePrompt", fields: [imagePromptId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────
// ASSETS (storage-backed files)
// ─────────────────────────────────────────────────────────────────────────

enum AssetType {
  IMAGE
  AUDIO
  VIDEO
}

model Asset {
  id              String    @id @default(cuid())
  projectId       String
  type            AssetType
  url             String
  storageProvider String
  sizeBytes       Int?
  mimeType        String?
  createdAt       DateTime  @default(now())

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedImages GeneratedImage[]
  voiceovers      Voiceover[]
  videoRenders    VideoRender[]
}

// ─────────────────────────────────────────────────────────────────────────
// GENERATION JOBS (async pipeline tracking)
// ─────────────────────────────────────────────────────────────────────────

enum JobStage {
  STRATEGY
  SCRIPT
  SCENES
  IMAGE_PROMPTS
  IMAGES
  VOICEOVER
  SOCIAL_COPY
  VIDEO_RENDER
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model GenerationJob {
  id          String    @id @default(cuid())
  projectId   String
  stage       JobStage
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stage])
}

// ─────────────────────────────────────────────────────────────────────────
// VIDEO ASSEMBLY (Phase 6) — images + voiceover + subtitles + transitions → MP4
// ─────────────────────────────────────────────────────────────────────────

enum TransitionStyle {
  CUT
  CROSSFADE
}

enum SubtitleStyle {
  BOLD_CENTER
  KARAOKE_HIGHLIGHT
  MINIMAL_BOTTOM
}

model VideoRenderSettings {
  id                 String          @id @default(cuid())
  projectId          String          @unique
  transition         TransitionStyle @default(CUT)
  subtitleStyle      SubtitleStyle   @default(BOLD_CENTER)
  backgroundMusicUrl String?
  musicVolume        Float           @default(0.15)
  updatedAt          DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model VideoRender {
  id           String    @id @default(cuid())
  projectId    String
  status       JobStatus @default(QUEUED)
  assetId      String?
  errorMessage String?   @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset   Asset?  @relation(fields: [assetId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────
// SCHEDULING / PUBLISHING (Phase 7 architecture, modeled now)
// ─────────────────────────────────────────────────────────────────────────

model Schedule {
  id            String         @id @default(cuid())
  projectId     String         @unique
  platform      SocialPlatform
  scheduledFor  DateTime
  status        String         @default("PENDING")
  createdAt     DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PlatformConnection {
  id          String         @id @default(cuid())
  userId      String
  platform    SocialPlatform
  oauthTokens Json // encrypted at rest by the app layer before write
  externalChannelId    String?
  externalChannelTitle String?
  connectedAt DateTime       @default(now())
  lastSyncedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

// ─────────────────────────────────────────────────────────────────────────
// CHANNEL LEARNING — synced performance data + AI-generated insights
// ─────────────────────────────────────────────────────────────────────────

model ChannelVideoMetric {
  id           String         @id @default(cuid())
  userId       String
  platform     SocialPlatform @default(YOUTUBE)
  externalId   String
  title        String
  description  String?        @db.Text
  publishedAt  DateTime
  durationSec  Int?
  thumbnailUrl String?
  tags         String[]       @default([])
  views        Int            @default(0)
  likes        Int            @default(0)
  comments     Int            @default(0)
  fetchedAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, externalId])
  @@index([userId, platform, views])
}

model ChannelInsight {
  id                      String         @id @default(cuid())
  userId                  String
  platform                SocialPlatform @default(YOUTUBE)
  videosAnalyzed          Int
  topPerformingPatterns   String         @db.Text
  commonMistakes          String         @db.Text
  recommendedImprovements String         @db.Text
  bestPostingTimes        String         @db.Text
  topHookStyles           String         @db.Text
  topicRecommendations    String         @db.Text
  generatedAt             DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, generatedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// PROVIDER REGISTRY + COST TRACKING
// ─────────────────────────────────────────────────────────────────────────

enum ProviderType {
  AI_TEXT
  AI_IMAGE
  AI_VOICE
  SOCIAL
  STORAGE
}

model Provider {
  id       String       @id @default(cuid())
  name     String       @unique
  type     ProviderType
  isActive Boolean      @default(true)
  config   Json?
}

model ApiUsage {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  model           String?
  requestType     String
  units           Int? // tokens, characters, or image count depending on provider
  estimatedCostUsd Float?
  success         Boolean
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
